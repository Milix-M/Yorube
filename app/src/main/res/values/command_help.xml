    <string name="slash_branch_usage">/branch [name]</string>
    <string name="slash_stop_description">Stop the run in this conversation.</string>
    <string name="slash_stop_usage">/stop</string>
    <string name="slash_discard_description">Discard a run with an unknown outcome without resending it.</string>
    <string name="slash_discard_usage">/discard [run ID]</string>
    <string name="slash_approve_description">Approve the pending request using an offered choice.</string>
    <string name="slash_approve_usage">/approve [once|session|always]</string>
    <string name="slash_deny_description">Deny the pending approval request.</string>
    <string name="slash_deny_usage">/deny</string>
    <string name="slash_bg_description">Run a prompt in a separate background conversation.</string>
    <string name="slash_bg_usage">/bg &lt;prompt&gt;</string>
    <string name="slash_agents_description">List the runs tracked by this app.</string>
    <string name="slash_agents_usage">/agents</string>
    <string name="slash_queue_description">Queue the next prompt, or edit the queue. Positions start at 1. Sends immediately when idle.</string>
    <string name="slash_queue_usage">/queue &lt;text&gt;\n/queue list\n/queue add &lt;text&gt;\n/queue edit &lt;position&gt; &lt;text&gt;\n/queue move &lt;from&gt; &lt;to&gt;\n/queue rm &lt;position&gt;\n/queue clear</string>
    <string name="slash_steer_description">Add an instruction to the active run.</string>
    <string name="slash_steer_usage">/steer &lt;text&gt;</string>
    <string name="slash_status_description">Show the current conversation and model status.</string>
    <string name="slash_status_usage">/status</string>
    <string name="slash_resume_description">Open a conversation by name or ID. Use its ID if names overlap.</string>
    <string name="slash_resume_usage">/resume &lt;name or ID&gt;</string>
    <string name="slash_sessions_description">List conversations and their IDs.</string>
    <string name="slash_sessions_usage">/sessions</string>
    <string name="slash_config_description">Show the connection host and model settings.</string>
    <string name="slash_config_usage">/config</string>
    <string name="slash_model_description">Show models or select a model for future runs.</string>
    <string name="slash_model_usage">/model [model]\n/model --provider &lt;provider&gt; &lt;model&gt;</string>
    <string name="slash_reasoning_description">Show or set reasoning effort for future runs. Support depends on the model.</string>
    <string name="slash_reasoning_usage">/reasoning [none|minimal|low|medium|high|xhigh|max|ultra]</string>
    <string name="slash_fast_description">Show or set normal/priority processing for future runs.</string>
    <string name="slash_fast_usage">/fast [normal|fast|status]</string>
    <string name="slash_tools_description">List available toolsets. Settings are read-only.</string>
    <string name="slash_tools_usage">/tools [list]</string>
    <string name="slash_skills_description">List, search or inspect installed skills.</string>
    <string name="slash_skills_usage">/skills [list]\n/skills search &lt;query&gt;\n/skills show &lt;name&gt;</string>
    <string name="slash_cron_description">List or manage scheduled tasks. Schedule format depends on the server.</string>
    <string name="slash_cron_usage">/cron [list]\n/cron show &lt;ID&gt;\n/cron add &lt;name&gt; | &lt;schedule&gt; | &lt;prompt&gt;\n/cron edit &lt;ID&gt; &lt;name&gt; | &lt;schedule&gt; | &lt;prompt&gt;\n/cron pause|resume|run|remove &lt;ID&gt;</string>
    <string name="slash_reload_skills_description">Fetch the installed skills list again.</string>
    <string name="slash_reload_skills_usage">/reload-skills</string>
