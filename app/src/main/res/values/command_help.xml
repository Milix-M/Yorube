    <string name="slash_usage_usage">/usage</string>
    <string name="slash_copy_description">Copy the last response to the clipboard.</string>
    <string name="slash_copy_usage">/copy</string>
    <string name="slash_version_description">Show the Yorube app version.</string>
    <string name="slash_version_usage">/version</string>
    <string name="slash_redraw_usage">/redraw</string>
    <string name="slash_toolsets_usage">/toolsets</string>
    <string name="slash_palette_usage">/palette</string>
    <string name="slash_unavailable">Not available in Yorube.</string>
</resources>
