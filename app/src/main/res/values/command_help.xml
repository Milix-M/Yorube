<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="slash_new_description">Start a new conversation, optionally with a name.</string>
    <string name="slash_new_usage">/new [name]</string>
    <string name="slash_clear_description">Start a new conversation.</string>
    <string name="slash_clear_usage">/clear</string>
    <string name="slash_history_description">Reload this conversation when no run is active.</string>
    <string name="slash_history_usage">/history</string>
    <string name="slash_save_description">Open Android sharing with the conversation text.</string>
    <string name="slash_save_usage">/save</string>
    <string name="slash_retry_description">Resend the last user message.</string>
    <string name="slash_retry_usage">/retry</string>
    <string name="slash_prompt_description">Put text into the input field without sending it.</string>
    <string name="slash_prompt_usage">/prompt &lt;text&gt;</string>
    <string name="slash_title_description">Show the conversation name, or change it.</string>
    <string name="slash_title_usage">/title [name]</string>
